# Copy to .env for local runs, or set these in Render.
AAINA_LLM=auto                # auto | deepseek | claude | offline  (auto prefers DeepSeek, then Claude)
DEEPSEEK_API_KEY=             # text AI: recommendations, profile, routines (cannot read photos)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=            # optional: Claude adds photo analysis (set AAINA_LLM=claude)
AAINA_MODEL=claude-opus-5-5
DATABASE_URL=sqlite:///./aaina.db   # production: your Neon/Supabase Postgres URL
ALLOWED_ORIGINS=http://localhost:4200
ADMIN_KEY=                    # set in production so only you can create salons

