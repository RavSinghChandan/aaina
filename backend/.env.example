# Copy to .env for local runs, or set these in Render.
ANTHROPIC_API_KEY=            # empty = offline mode (rules only, no photo analysis)
AAINA_PROVIDER=auto           # auto | offline
AAINA_MODEL=claude-opus-5-5
DATABASE_URL=sqlite:///./aaina.db   # production: your Neon/Supabase Postgres URL
ALLOWED_ORIGINS=http://localhost:4200
ADMIN_KEY=                    # set in production so only you can create salons
